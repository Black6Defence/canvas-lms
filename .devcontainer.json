{
  "name": "canvas-lms",
  "dockerComposeFile": [
    "docker-compose.yml",
    "docker-compose.codespaces.yml"
  ],
  "service": "web",
  "workspaceFolder": "/usr/src/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "dbaeumer.vscode-eslint",
        "koichisasada.vscode-rdbg",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "Shopify.ruby-lsp",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "bash script/codespaces_setup.sh"
}
